# AI API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Local SQLite (Development only)
# USE_LOCAL_DB=true
# DATABASE_PATH=./data/dictionary.db

# Application
NEXT_PUBLIC_APP_NAME=Omnidict
NEXT_PUBLIC_APP_VERSION=2.0.0

# Turso DB Secrets
TURSO_AUTH_TOKEN=your_turso_auth_token_here
TURSO_DATABASE_URL=libsql://your-database-url.turso.io

# Refold SSO / Auth
# Shared HMAC secret for the SSO handshake (must match Refold's OMNIDICT_SSO_SECRET)
OMNIDICT_SSO_SECRET=your_sso_shared_secret_here
# Bearer secret for server-to-server entitlement lookups (must match Refold's OMNIDICT_API_SECRET)
OMNIDICT_API_SECRET=your_api_shared_secret_here
# Secret used to sign Omnidict session JWTs
OMNIDICT_SESSION_SECRET=your_session_signing_secret_here
# Refold platform base URL (https://refold.la in production, http://localhost:3000 in dev)
REFOLD_BASE_URL=https://refold.la
# Public URL of this app (https://dict.refold.la in production, http://localhost:3200 in dev)
NEXT_PUBLIC_APP_URL=https://dict.refold.la

# Media Generation
# Google Cloud TTS key for word audio (env-keyed, free for all users)
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here
# ElevenLabs key for sentence audio — spent only for paid Refold users (quota-limited)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Replicate token for image generation — spent only for paid Refold users (quota-limited)
REPLICATE_API_TOKEN=your_replicate_api_token_here
# OpenRouter key for the OpenRouter AI provider (also used for image prompts)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Monthly included media quotas for paid Refold users (defaults shown)
MEDIA_QUOTA_IMAGES_PER_MONTH=300
MEDIA_QUOTA_TTS_PER_MONTH=600
